  "sources": [
    {
      "id": "navsari-grant",
      "text": "The Navsari Inscription (738-739 CE) records that the Tajika (Arab) army, having destroyed the kingdoms of Saindhava, Kachchella, Saurashtra, Chavotkata, and Maurya, attempted to penetrate the Deccan. Avanijanashraya Pulakeshin, Chalukya viceroy of Gujarat, met them at Navsari and annihilated their forces, earning the title 'Tajikanivaraka'.",
      "refs": [
        "Mirashi, V. V., Corpus Inscriptionum Indicarum, Vol. IV (Inscriptions of the Kalachuri-Chedi Era)",
        "Bhandarkar, D. R., Indian Antiquary, Vol. XVII"
      ]
    },
    {
      "id": "gwalior-prasasti",
      "text": "The Gwalior Prasasti of Bhoja I records that Nagabhata I crushed the large invading Mlechchha (Arab) army in Rajasthan and Malwa, serving as a divine bulwark against the foreign host.",
      "refs": [
        "Epigraphia Indica, Vol. XVIII (Gwalior Inscription of Bhoja I)",
        "Majumdar, R. C., The Classical Age (The History and Culture of the Indian People)"
      ]
    }
  ]
